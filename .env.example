# PostgreSQL connection string from your Supabase project (Project Settings > Database).
# Use the connection string appropriate for Prisma. Never commit a real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth.js secret. Generate one with: openssl rand -base64 32
# Wired up in the authentication feature; keep it server-only.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Public base URL of the application.
AUTH_URL="http://localhost:3000"
